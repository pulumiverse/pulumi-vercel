{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:best-practices"],
  "dependencyDashboard": true,
  "configMigration": true,
  "packageRules": [
    {
      "description": "Provider and bridge upgrades must go through `make tfgen` + `make generate_sdks` (upgrade-provider workflow), never a bare go.mod bump. Suffix glob is required because the module paths carry major-version suffixes (/v5, /v3).",
      "matchPackageNames": [
        "github.com/vercel/terraform-provider-vercel{/,}**",
        "github.com/pulumi/pulumi-terraform-bridge{/,}**"
      ],
      "enabled": false
    },
    {
      "matchFileNames": [
        "sdk/**",
        ".github/**"
      ],
      "enabled": false
    },
    {
      "matchUpdateTypes": ["minor", "patch", "lockFileMaintenance"],
      "groupName": "minor/patch updates"
    },
    {
      "description": "Opt-out minimum Go version updates: https://github.com/renovatebot/renovate/issues/16715",
      "matchManagers": ["gomod"],
      "matchDepTypes": ["golang"],
      "enabled": false
    }
  ],
  "automerge": true,
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["before 4am on Friday"]
  },
  "minimumReleaseAge": "3 days",
  "postUpdateOptions": ["gomodTidy"]
}
